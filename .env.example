# ============================================================
# MindBloom — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.
# ============================================================

# ── Supabase (Sprint 1) ───────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Paste Supabase Publishable key here (or the legacy anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Settings → API → service_role (SECRET — server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (Sprint 8, 9, 10, 12) ───────────────────────────────
# platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key

# ── Midtrans (Sprint 14) ───────────────────────────────────────
# dashboard.midtrans.com → Settings → Access Keys
# Use Sandbox keys (SB-Mid-...) until you're ready to go live.
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key
MIDTRANS_IS_PRODUCTION=false

NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
